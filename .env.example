# Backend environment variables
# Copy this file to Backend/.env and fill in your values.
# NEVER commit real secrets to source control.

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (Supabase) — required for Prisma
# Use the connection string from Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional: separate database for backend tests (strongly recommended)
# Use a dedicated Supabase branch or local Postgres instance — never run tests against production.
TEST_DATABASE_URL=

# JWT secret for auth tokens (change in production)
JWT_SECRET=replace_with_a_secure_random_value

# Supabase Storage (file uploads — not used for database queries)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
# Alternative name also supported by the app:
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# Optional: use local filesystem instead of Supabase Storage
LOCAL_UPLOADS=true

# Email (password reset)
SENDGRID_API_KEY=

# Optional seed overrides (defaults work for local development)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=

# Frontend API base URL (Vite)
VITE_API_BASE_URL=http://localhost:3001/api
